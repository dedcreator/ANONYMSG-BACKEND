# Production Environment Variables for Render Deployment
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Database (Automatically populated by Render PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: Redis for WebSocket Channels (if using Render Redis)
# REDIS_URL=rediss://default:password@host:6379

# Email SMTP (Gmail App Password or Resend API)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
RESEND_API_KEY=re_your_resend_api_key

# Payment Gateway Keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_HASH=your_webhook_secret_hash
